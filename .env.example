# Copy to .env and fill in. Never commit .env.

# Any OpenAI-compatible endpoint. Defaults to AI Pipe (https://aipipe.org).
API_KEY=
API_BASE_URL=https://aipipe.org/openai/v1

# Optional overrides
# VTA_CONFIG=configs/baseline.yaml   # experiment served by the API
# VTA_DATA_DIR=data
# VTA_CACHE_DIR=.cache
# VTA_RUNS_DIR=runs
# VTA_REQUEST_TIMEOUT=60
# CORS_ORIGINS=*                     # comma-separated list

# Discourse scraping (`vta scrape discourse`): the `_t` and `_forum_session` cookies from a
# logged-in browser (DevTools -> Application -> Cookies). They grant full account access.
# DISCOURSE_COOKIE=_t=...; _forum_session=...
